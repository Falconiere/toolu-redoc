{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolu-redoc-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
  },
  "env": {
    "development": {
      "name": "toolu-redoc-api-dev",
      "vars": {
        "APP_ENV": "development",
      },
    },
  },
  "observability": {
    "enabled": true,
  },
}
