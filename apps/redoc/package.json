{
  "name": "@toolu-redoc/redoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt --ignore-path ../../.oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path ../../.oxfmtignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:structure": "bash ../../scripts/guardrails/run.sh",
    "check:dupes": "jscpd",
    "check": "bun run type-check && bun run lint && bun run fmt:check && bun run check:structure && bun run check:dupes && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-router": "1.131.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.14",
    "yaml": "2.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.131.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.6.0",
    "jscpd": "4.0.5",
    "jsdom": "26.1.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.0",
    "wrangler": "4.45.0"
  }
}
