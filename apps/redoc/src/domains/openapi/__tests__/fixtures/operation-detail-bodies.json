{
  "openapi": "3.0.3",
  "info": {
    "title": "Operation detail bodies",
    "version": "1.0.0"
  },
  "paths": {
    "/upload": {
      "post": {
        "operationId": "uploadThing",
        "summary": "Multi-media body and mixed responses",
        "requestBody": {
          "required": true,
          "description": "Payload in three media types",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              },
              "example": { "name": "json" }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok with header",
            "headers": {
              "X-RateLimit": {
                "description": "calls remaining",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "examples": {
                  "ok": { "value": { "ok": true } }
                }
              }
            }
          },
          "default": {
            "description": "default error",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "2XX": {
            "description": "range success",
            "content": {
              "application/json": {
                "schema": { "type": "boolean" }
              }
            }
          },
          "204": {
            "description": "no content"
          }
        }
      }
    }
  }
}
