{
  "openapi": "3.0.3",
  "info": {
    "title": "Schema rail ops 3.0",
    "version": "1.0.0",
    "description": "Hand-authored for issue #7 — T16 3.0 distinctions, external $ref, bodyless 204"
  },
  "paths": {
    "/nullable": {
      "get": {
        "responses": {
          "200": {
            "description": "nullable string",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NullableString30" }
              }
            }
          }
        }
      }
    },
    "/falsy": {
      "get": {
        "responses": {
          "200": {
            "description": "falsy literals object",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FalsyLiterals" }
              }
            }
          }
        }
      }
    },
    "/arrays": {
      "get": {
        "responses": {
          "200": {
            "description": "array constraints",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ArrayConstraints" }
              }
            }
          }
        }
      }
    },
    "/read-write": {
      "get": {
        "responses": {
          "200": {
            "description": "readOnly writeOnly",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadWrite" }
              }
            }
          }
        }
      }
    },
    "/additional": {
      "get": {
        "responses": {
          "200": {
            "description": "additionalProperties schema",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdditionalPropsSchema" }
              }
            }
          }
        }
      }
    },
    "/external": {
      "get": {
        "responses": {
          "200": {
            "description": "external schema ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://example.com/schemas/RemotePet.json"
                }
              }
            }
          }
        }
      }
    },
    "/empty": {
      "delete": {
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NullableString30": {
        "type": "string",
        "nullable": true
      },
      "NoTypeInvented": {
        "description": "no type or required invented"
      },
      "FalsyLiterals": {
        "type": "object",
        "properties": {
          "flag": { "type": "boolean", "default": false, "enum": [false, true] },
          "count": { "type": "integer", "default": 0, "enum": [0, 1] },
          "name": { "type": "string", "default": "", "enum": ["", "x"] },
          "maybe": { "nullable": true, "default": null, "enum": [null, "y"] }
        },
        "additionalProperties": false,
        "readOnly": false,
        "writeOnly": false
      },
      "ArrayConstraints": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 0,
        "maxItems": 3,
        "uniqueItems": true,
        "default": []
      },
      "ReadWrite": {
        "type": "object",
        "properties": {
          "createdAt": { "type": "string", "readOnly": true },
          "secret": { "type": "string", "writeOnly": true }
        }
      },
      "AdditionalPropsSchema": {
        "type": "object",
        "additionalProperties": { "type": "number" }
      }
    }
  }
}
