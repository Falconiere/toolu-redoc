{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolu-redoc-redoc",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "development": {
      "name": "toolu-redoc-redoc-dev",
    },
  },
  "observability": {
    "enabled": true,
  },
}
