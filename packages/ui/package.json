{
  "name": "@toolu-redoc/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/surface": "./src/components/surface.tsx",
    "./utilities/class-names": "./src/utilities/class-names.ts"
  },
  "scripts": {
    "check": "bun run type-check && bun run lint && bun run fmt:check && bun run check:structure && bun run check:dupes && bun run test",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --fix --type-aware --deny-warnings",
    "fmt": "oxfmt --ignore-path ../../.oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path ../../.oxfmtignore",
    "check:structure": "bash ../../scripts/guardrails/run.sh",
    "check:dupes": "jscpd",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "jscpd": "4.0.5",
    "jsdom": "26.1.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
